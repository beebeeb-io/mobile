            android:data="beebeeb://search"/>
    </shortcut>
    <shortcut android:shortcutId="photos"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_photos"
        android:shortcutLongLabel="@string/shortcut_photos_long">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="io.beebeeb.app"
            android:targetClass="io.beebeeb.app.MainActivity"
            android:data="beebeeb://photos"/>
    </shortcut>
