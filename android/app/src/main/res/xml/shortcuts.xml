<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="upload"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_upload"
        android:shortcutLongLabel="@string/shortcut_upload_long">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="io.beebeeb.app"
            android:targetClass="io.beebeeb.app.MainActivity"
            android:data="beebeeb://upload"/>
    </shortcut>
    <shortcut android:shortcutId="search"
