# Beebeeb Mobile — Environment Config
# Copy to .env and adjust for your setup

# API server URL consumed by app.config.js and src/lib/api.ts.
# Leave unset to use app.json's default (currently https://api.beebeeb.io).
#
# Local API modes:
# - iOS simulator: http://localhost:3001
# - Android emulator: http://10.0.2.2:3001 (Android's alias for host localhost)
# - Physical device: http://<your-lan-ip>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
