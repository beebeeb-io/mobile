# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)

# ENTRY_FILE: pin the RN/Expo bundler entry to a RELATIVE path (task 0671).
# The "Bundle React Native code and images" script only computes an ABSOLUTE
# entry (via `expo/scripts/resolveAppEntry … absolute`) when ENTRY_FILE is empty.
# Under `eas build --local`, the project is staged in a symlinked tmpdir
# (/tmp → /private/tmp, /var/folders/…/T → /private/var/…). The absolute entry
# then carries the unresolved symlink form while Metro realpaths its projectRoot,
# so Metro sees the entry OUTSIDE the project root → "Unable to resolve module
# …/src/App.tsx" on ANY entry → ARCHIVE FAILED. A RELATIVE entry resolves against
# Metro's realpath'd cwd in both local and eas-staged builds, sidestepping the
# mismatch. (Local real-repo builds were unaffected — no symlinked tmpdir.)
export ENTRY_FILE="src/App.tsx"
