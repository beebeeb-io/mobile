# Dependencies & vendor
node_modules/
vendor/
# Exception: src/lib/vendor/ holds a generated-but-committed source file (the
# base64 three.js payload the constellation WebView imports at build time —
# task 1367, scripts/vendor-three.sh regenerates it). It is source, not a
# fetched dependency, so the blanket vendor/ rule above must not hide it.
!src/lib/vendor/
!src/lib/vendor/**
.pnpm-store/
bun.lockb

# Build artifacts
target/
dist/
build/
.next/
.astro/
*.wasm

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.jks
*.keystore
*.secret
credentials
credentials/
id_rsa
id_ed25519
credentials.json
service_account.json
token.json

# Local data
data/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.swp
*.swo
*~
.vscode/settings.json
.vscode/launch.json

# Logs
*.log
npm-debug.log*

# Test & coverage
coverage/
.nyc_output/
*.lcov

# Expo / React Native
.expo/
ios/Pods/
android/.gradle/
android/app/build/

# Playwright MCP captures (logs, snapshots) - ignored repo-wide
.playwright-mcp/
test-results/
playwright-report/

# Graphify local files (not committed)
graphify-out/.graphify_root
graphify-out/cache/
e2e/
*.png

# App icons required by EAS Build and App Store Connect.
!assets/icon.png
!assets/adaptive-icon.png
!ios/Beebeeb/Images.xcassets/AppIcon.appiconset/*.png
