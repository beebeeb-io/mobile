<?xml version="1.0" encoding="utf-8"?>
<!--
  Task 1683j — the streaming video engine serves the decrypted output to
  ExoPlayer (expo-video's OkHttpDataSource) over a LOOPBACK-only HTTP server
  (http://127.0.0.1:<port>/s/<streamId>/…). Cleartext is permitted for the
  loopback interface ONLY: the vault's API always runs over TLS, and no other
  cleartext host is allowed. When a networkSecurityConfig is present the
  platform IGNORES android:usesCleartextTraffic (the debug overlay's flag) —
  debug builds override this file (see src/debug/res/xml) to keep Metro over
  the LAN working.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
