# Dependencies & vendor
node_modules/
vendor/
# Exception: src/lib/vendor/ holds a generated-but-committed source file (the
# base64 three.js payload the constellation WebView imports at build time —
# task 1367, scripts/vendor-three.sh regenerates it). It is source, not a
# fetched dependency, so the blanket vendor/ rule above must not hide it.
!src/lib/vendor/
!src/lib/vendor/**
.pnpm-store/
bun.lockb

# Build artifacts
target/
dist/
build/
.next/
.astro/
*.wasm

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.jks
*.keystore
*.secret
credentials
credentials/
id_rsa
id_ed25519
credentials.json
service_account.json
token.json

# Local data
data/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.swp
*.swo
*~
.vscode/settings.json
.vscode/launch.json

# Logs
*.log
npm-debug.log*

# Test & coverage
coverage/
.nyc_output/
*.lcov

# Expo / React Native
.expo/
ios/Pods/
android/.gradle/
android/app/build/

# Playwright MCP captures (logs, snapshots) — ignored repo-wide
.playwright-mcp/
test-results/
playwright-report/

# Graphify local files (not committed)
graphify-out/.graphify_root
graphify-out/cache/
# Ignore e2e ARTIFACTS only — never the flows/specs themselves. A blanket `e2e/` rule
# silently kept new Maestro flows out of git (dark-mode-test.yaml was lost this way); the
# 16 already-tracked e2e files were only safe because gitignore does not affect tracked files.
e2e/artifacts/
e2e/.maestro/
*.png
!assets/icon.png
!assets/adaptive-icon.png
!ios/Beebeeb/Images.xcassets/AppIcon.appiconset/*.png
# App Store screenshots (task 1402) — the actual submission deliverable the
# `deliver` fastlane lane uploads, not a local dev/QA capture like everything
# else the blanket *.png rule above is meant to keep out of git.
!fastlane/screenshots/**/*.png

# Fastlane credential-bearing / generated files (task 1402) — never commit.
# review_information/ is where `deliver download_metadata` (or a prior
# manual `deliver` run) would write the demo account + reviewer notes
# (including the 12-word recovery phrase) to disk as plain text; report.xml
# and Preview.html are per-run generated artifacts (the HTML-diff preview
# `force:` skips, and the fastlane run report), not source.
fastlane/metadata/review_information/
fastlane/report.xml
fastlane/Preview.html

# Google Play service account key (secret — do not commit)
google-service-account.json

# Local test/debug captures — never commit (real user data fingerprints)
/diagnostics/
/screenshots/
/.superpowers/
*.db-shm
*.db-wal
*.mp4
*.mov

# Marketing app-store screenshots are intentionally tracked
# (override the broad *.png rule above)
!marketing/app-store/**/*.png
