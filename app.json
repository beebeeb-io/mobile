{
  "expo": {
    "name": "Beebeeb",
    "slug": "beebeeb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.beebeeb.app",
      "appleTeamId": "R8352WDJJR",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.beebeeb.shared",
          "group.io.beebeeb.shared"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)io.beebeeb.shared",
          "$(AppIdentifierPrefix)io.beebeeb.shared"
        ]
      },
      "infoPlist": {
        "NSFileProviderPresenceAuthorized": true,
        "NSCameraUsageDescription": "Beebeeb scans the amber constellation pattern to pair a new device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1714"
      },
      "package": "io.beebeeb.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "./modules/beebeeb-crypto"
    ],
    "extra": {
      "eas": {
        "projectId": "e8891cb5-44d2-493c-ba4b-4581a78ca198"
      }
    },
    "owner": "devidee-bv"
  }
}
