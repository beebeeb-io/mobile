{
  "expo": {
    "name": "Beebeeb",
    "slug": "beebeeb",
    "scheme": "beebeeb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.beebeeb.app",
      "appleTeamId": "R8352WDJJR",
      "icon": "./assets/icon.png",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.beebeeb.shared"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)io.beebeeb.shared"
        ]
      },
      "associatedDomains": [
        "applinks:beebeeb.io",
        "applinks:app.beebeeb.io"
      ],
      "infoPlist": {
        "CFBundleIconName": "AppIcon",
        "NSFileProviderPresenceAuthorized": true,
        "NSCameraUsageDescription": "Beebeeb scans the amber constellation pattern to pair a new device.",
        "NSPhotoLibraryUsageDescription": "Beebeeb backs up your photos with end-to-end encryption.",
        "NSPhotoLibraryAddUsageDescription": "Beebeeb saves downloaded photos to your library.",
        "NSCalendarsUsageDescription": "Beebeeb backs up your calendar with end-to-end encryption.",
        "NSCalendarsFullAccessUsageDescription": "Beebeeb backs up your calendar with end-to-end encryption.",
        "NSRemindersUsageDescription": "Beebeeb backs up your reminders with end-to-end encryption.",
        "NSRemindersFullAccessUsageDescription": "Beebeeb backs up your reminders with end-to-end encryption.",
        "NSContactsUsageDescription": "Beebeeb backs up your contacts with end-to-end encryption.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserActivityTypes": [
          "io.beebeeb.app.upload",
          "io.beebeeb.app.search",
          "io.beebeeb.app.scan"
        ],
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "remote-notification"
        ],
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "io.beebeeb.upload",
            "UIApplicationShortcutItemTitle": "Upload File",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAdd",
            "UIApplicationShortcutItemUserInfo": {
              "url": "beebeeb://upload"
            }
          },
          {
            "UIApplicationShortcutItemType": "io.beebeeb.scan",
            "UIApplicationShortcutItemTitle": "Scan Document",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose",
            "UIApplicationShortcutItemUserInfo": {
              "url": "beebeeb://scan"
            }
          },
          {
            "UIApplicationShortcutItemType": "io.beebeeb.recent",
            "UIApplicationShortcutItemTitle": "Recent Files",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeTime",
            "UIApplicationShortcutItemUserInfo": {
              "url": "beebeeb://recent"
            }
          }
        ]
      },
      "buildNumber": "80"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1714"
      },
      "package": "io.beebeeb.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-local-authentication",
      "expo-document-picker",
      "expo-media-library",
      "./modules/beebeeb-crypto/app.plugin.js",
      "./plugins/uniffi-bridge/withUniffiBridge.js",
      "./plugins/file-provider/withFileProvider.js",
      "./plugins/share-extension/withShareExtension.js",
      "./plugins/withWidget",
      "./plugins/fmt-patch/withFmtPatch.js",
      "./plugins/shortcut-bridge/withShortcutBridge.js",
      "expo-video",
      "expo-image-picker"
    ],
    "extra": {
      "apiUrl": "https://api.beebeeb.io",
      "eas": {
        "projectId": "e8891cb5-44d2-493c-ba4b-4581a78ca198"
      }
    },
    "owner": "devidee-bv"
  }
}